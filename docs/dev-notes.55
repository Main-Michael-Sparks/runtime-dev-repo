runtime/request/scheduler.mjs
runtime/request/request.mjs
runtime/request/runtimeRequestSettlement.mjs
runtime/lifecycle/**
runtime/stream/**
runtime/config/**
runtime/backends/nativeWorker/nativeWorkerBackendExecution.mjs
```

The event registry does not import:

```text
runtime.mjs
workerBridge
llama_worker
node-llama-cpp
scheduler/request/stream/lifecycle/backends
executeAction execution modules
```

